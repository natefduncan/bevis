  "source": "warehouse.orders",
  "sql": "WITH by_account AS (\n  SELECT account_id,\n         SUM(amount) FILTER (WHERE year = 2024) AS rev_2024,\n         SUM(amount) FILTER (WHERE year = 2025) AS rev_2025\n  FROM orders WHERE refunded = false GROUP BY account_id\n)\nSELECT b.account_id, a.name AS account_name, a.segment, b.rev_2024, b.rev_2025,\n       b.rev_2025 - b.rev_2024 AS change\nFROM by_account b JOIN accounts a USING (account_id)\nWHERE b.rev_2024 > 0\nORDER BY change ASC\nLIMIT :n;",
