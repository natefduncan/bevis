          "type": "integer"
        }
      ],
      "rows": [
        [
          "2025-03-01T00:00:00Z",
          4
        ]
      ]
    },
    "q-flags": {
      "key": [
        "active"
      ],
      "columns": [
        {
          "name": "active",
          "type": "boolean"
        },
        {
          "name": "n",
          "type": "integer"
        }
      ],
      "rows": [
        [
          true,
          30
        ],
        [
          false,
          12
        ]
      ]
    },
    "q-buckets": {
      "key": [
        "bucket"
      ],
      "columns": [
        {
          "name": "bucket",
          "type": "integer"
        },
        {
          "name": "n",
          "type": "integer"
        }
      ],
      "rows": [
        [
          -1,
          3
        ],
        [
          0,
          8
        ],
        [
          1,
