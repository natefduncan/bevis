{
  "description": "Shared test cases for the Bevis expression language. See README.md.",
  "evidence": {
    "q-rev-yoy": {
      "key": [
        "year"
      ],
      "columns": [
        {
          "name": "year",
          "type": "integer"
        },
        {
          "name": "revenue",
          "type": "decimal"
        }
      ],
      "rows": [
        [
          2024,
          "4210000"
        ],
        [
          2025,
          "3705000"
        ]
      ]
    },
    "q-seg-delta": {
      "key": [
        "segment",
        "year"
      ],
      "columns": [
        {
          "name": "segment",
          "type": "string"
        },
        {
          "name": "year",
          "type": "integer"
        },
        {
          "name": "revenue",
          "type": "decimal"
        },
        {
          "name": "churn_rate",
          "type": "decimal"
        }
      ],
      "rows": [
        [
          "Enterprise",
          2024,
          "2100000",
          "0.041"
        ],
        [
          "Enterprise",
          2025,
          "1950000",
          "0.052"
        ],
        [
          "Mid-market",
          2024,
          "1460000",
          "0.088"
        ],
        [
          "Mid-market",
          2025,
          "1185000",
          null
        ],
        [
          "SMB",
          2024,
          "650000",
          "0.120"
        ],
        [
          "SMB",
