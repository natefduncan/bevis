{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bevis.dev/schema/bundle/1/evidence.schema.json",
  "title": "Bevis evidence record (evidence/<id>.v<N>.json)",
  "type": "object",
  "required": [
    "id", "version", "source", "sql", "params", "run_at", "provenance",
    "key", "columns", "row_count", "data_hash", "assumptions", "disclosure"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "version": { "type": "integer", "minimum": 1 },
    "source": { "type": "string" },
    "sql": { "type": "string" },
    "params": { "type": "object" },
    "run_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "provenance": { "enum": ["agent-reported", "host-verified", "browser-checked", "receipt-signed"] },
    "key": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["string", "integer", "decimal", "date", "datetime", "boolean", "null"] }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": { "type": "array" }
    },
    "row_count": { "type": "integer", "minimum": 0 },
    "data_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "partial": { "type": "boolean" },
    "source_row_count": { "type": "integer", "minimum": 0 },
    "disclosure": {
      "type": "object",
      "required": ["level", "withheld_rows"],
      "additionalProperties": false,
      "properties": {
        "level": { "$ref": "common.schema.json#/$defs/disclosure_level" },
        "withheld_rows": { "type": "integer", "minimum": 0 },
        "withheld_columns": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "dependentRequired": { "partial": ["source_row_count"] }
}
